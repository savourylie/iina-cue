    "/sessions/{id}/render-ack": {
      "post": {
        "summary": "Fence installed coverage by revision, hash and epoch",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        },
        "parameters": [
          {
            "name": "X-Cue-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "revision",
                  "sha256",
                  "seek_epoch",
                  "success"
                ],
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "seek_epoch": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "success": {
                    "type": "boolean"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON-serialized request object"
                  }
                }
              }
            }
          }
        }
      }
    },
