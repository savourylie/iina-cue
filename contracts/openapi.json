            "name": "X-Cue-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sessions": {
      "post": {
        "summary": "Create idempotent media session",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        },
        "parameters": [
          {
            "name": "X-Cue-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request_id",
                  "path"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "path": {
                    "type": "string",
                    "description": "Absolute local media path"
                  },
                  "position_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "track": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "enum": [
                          "original",
                          "zh-TW",
                          "zh-CN",
                          "en",
                          "ja",
                          "ko"
                        ]
                      },
                      "source": {
                        "enum": [
                          "auto",
                          "en",
                          "zh",
                          "ja",
                          "ko"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON-serialized request object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}": {
      "delete": {
        "summary": "Stop one session",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        },
        "parameters": [
          {
            "name": "X-Cue-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ]
      }
    },
    "/sessions/{id}/playback": {
      "put": {
        "summary": "Ordered playback/seek update",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        },
        "parameters": [
          {
            "name": "X-Cue-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "client_seq",
                  "seek_epoch",
                  "position_ms"
                ],
                "properties": {
                  "client_seq": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "seek_epoch": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "position_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 8
                  },
                  "audio_delay_ms": {
                    "type": "integer",
                    "const": 0
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON-serialized request object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/snapshot": {
