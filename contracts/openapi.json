          },
          "404": {
            "description": "Missing or different-client session"
          }
        },
        "parameters": [
          {
            "name": "X-Cue-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON-serialized request object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/client": {
      "delete": {
        "summary": "Remove this client and its sessions",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
