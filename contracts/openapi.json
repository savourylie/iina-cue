{
  "openapi": "3.1.0",
  "info": {
    "title": "Cue local development API",
    "version": "0.1.0",
    "description": "Implemented preview subset. JSON request bodies or IINA application/x-www-form-urlencoded with a JSON payload field. All responses include instance_id. Host must match the actual loopback address/port; any Origin is rejected."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/v1",
      "variables": {
        "port": {
          "default": "49152",
          "description": "Actual OS-assigned port from private connection manifest"
        }
      }
    }
  ],
  "security": [
    {
      "BearerToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health without loading models",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        }
      }
    },
    "/setup": {
      "get": {
        "summary": "Asset presence only; does not claim inference readiness",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        }
      }
    },
    "/clients": {
      "post": {
        "summary": "Register a lease",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
            "description": "Invalid Host, Origin, or bearer token"
          },
          "404": {
            "description": "Missing or different-client session"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON-serialized request object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/heartbeat": {
      "post": {
        "summary": "Renew client lease and return live session IDs",
        "responses": {
          "200": {
            "description": "Success; JSON object containing instance_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, stale update, setup or runtime error"
          },
          "403": {
